@model IEnumerable<EPresupuestos.Presupuestos>

@{
    ViewData["Title"] = "Presupuestos";
}
<section class="container mt-4">
    <header class="d-flex justifity-content-between align-items-center mb-4">
        <h2 class="text-primary">@ViewData["Title"]</h2>
        <a asp-controller="Presupuestos" asp-action="Create" class="btn btn-primary">Crear Presupuesto</a>
    </header>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th style="whidth: 10%">ID</th>
                <th style="whidth: 20%">Nombre</th>
                <th style="whidth: 50%">Fecha Creación</th>
                <th style="whidth: 20%">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (EPresupuestos.Presupuestos presupuesto in Model)
            {
                <tr>
                    <td>@presupuesto.IdPresupuesto</td>
                    <td>@presupuesto.NombreDestinatario</td>
                    <td>@presupuesto.FechaCreada</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-primary btn-sm">Ver</a>
                        <a asp-action="Edit" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-primary btn-sm">Modificar</a>
                        <a asp-action="AgregarProducto" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-dark btn-sm">Agregar Producto</a>
                        <a asp-action="Delete" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>